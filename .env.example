# Environment Configuration (.env.example)

# Application
ENVIRONMENT=development
PORT=3000

# Cloudflare Workers & Bindings
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
KV_PORTFOLIO_CACHE_ID=your_kv_namespace_id

# Database (Drizzle ORM & Atlas)
# For local SQLite/D1 development:
DATABASE_URL=file:./local.db
# For PostgreSQL / Supabase / Neon / Cloudflare Hyperdrive:
# DATABASE_URL=postgresql://user:password@host:5432/portfolio_db

# Memory & AI Services (Mem0 / LLM)
MEM0_API_KEY=your_mem0_api_key
OPENAI_API_KEY=your_openai_api_key

# Promptfoo Evaluation Secrets (Optional)
PROMPTFOO_API_KEY=your_promptfoo_api_key
